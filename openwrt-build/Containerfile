# OpenWrt source-build environment (rootless podman).
#   podman build -t dsl-n55u-owrt openwrt-build/
#   openwrt-build/run.sh make -j$(nproc)
FROM docker.io/library/debian:bookworm

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential clang flex bison g++ gawk gcc-multilib g++-multilib gettext git \
      libncurses-dev libssl-dev python3 python3-dev python3-setuptools python3-pyelftools \
      rsync swig unzip zlib1g-dev file wget curl ca-certificates xz-utils zstd bzip2 \
      time patch diffutils perl locales less vim-tiny \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 FORCE_UNSAFE_CONFIGURE=0
WORKDIR /src
